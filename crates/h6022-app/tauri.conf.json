{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hantek 6022BE",
  "version": "0.1.0",
  "identifier": "dev.h6022.oscilloscope",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../ui"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../ui"
    },
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hantek 6022BE",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Oscilloscopio Hantek 6022BE con server MCP",
    "copyright": "MIT OR Apache-2.0",
    "macOS": {
      "signingIdentity": "Developer ID Application: MARCO ABBATTISTA (38C8C426NW)",
      "hardenedRuntime": true,
      "minimumSystemVersion": "11.0"
    }
  }
}
